<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bookssm.mapper.BookMapper">

    <resultMap id="bookMap" type="com.bookssm.entity.Book">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="author" column="author"/>
        <result property="publisher" column="publisher"/>
        <result property="isbn" column="isbn"/>
        <result property="price" column="price"/>
        <result property="costPrice" column="cost_price"/>
        <result property="coverImage" column="cover_image"/>
        <result property="description" column="description"/>
        <result property="categoryId" column="category_id"/>
        <result property="categoryName" column="category_name"/>
        <result property="stock" column="stock"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="bookColumns">
        b.id, b.title, b.author, b.publisher, b.isbn, b.price, b.cost_price,
        b.cover_image, b.description, b.category_id, c.name AS category_name,
        b.stock, b.status, b.created_at, b.updated_at
    </sql>

    <sql id="bookCondition">
        <where>
            <if test="title != null and title != ''">
                AND b.title LIKE CONCAT('%', #{title}, '%')
            </if>
            <if test="author != null and author != ''">
                AND b.author LIKE CONCAT('%', #{author}, '%')
            </if>
            <if test="publisher != null and publisher != ''">
                AND b.publisher LIKE CONCAT('%', #{publisher}, '%')
            </if>
            <if test="categoryId != null">
                AND b.category_id = #{categoryId}
            </if>
            <if test="status != null">
                AND b.status = #{status}
            </if>
        </where>
    </sql>

    <select id="findById" resultMap="bookMap">
        SELECT <include refid="bookColumns"/>
        FROM book b
        LEFT JOIN category c ON b.category_id = c.id
        WHERE b.id = #{id}
    </select>

    <select id="findByIsbn" resultMap="bookMap">
        SELECT <include refid="bookColumns"/>
        FROM book b
        LEFT JOIN category c ON b.category_id = c.id
        WHERE b.isbn = #{isbn}
    </select>

    <select id="countByCondition" resultType="long">
        SELECT COUNT(1)
        FROM book b
        <include refid="bookCondition"/>
    </select>

    <select id="findByCondition" resultMap="bookMap">
        SELECT <include refid="bookColumns"/>
        FROM book b
        LEFT JOIN category c ON b.category_id = c.id
        <include refid="bookCondition"/>
        ORDER BY b.updated_at DESC, b.id DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <insert id="insert" parameterType="com.bookssm.entity.Book" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO book (
            title, author, publisher, isbn, price, cost_price,
            cover_image, description, category_id, stock, status
        )
        VALUES (
            #{title}, #{author}, #{publisher}, #{isbn}, #{price}, #{costPrice},
            #{coverImage}, #{description}, #{categoryId}, #{stock}, #{status}
        )
    </insert>

    <update id="update" parameterType="com.bookssm.entity.Book">
        UPDATE book
        SET title = #{title},
            author = #{author},
            publisher = #{publisher},
            isbn = #{isbn},
            price = #{price},
            cost_price = #{costPrice},
            description = #{description},
            category_id = #{categoryId},
            status = #{status}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM book
        WHERE id = #{id}
    </delete>

    <update id="updateStatus">
        UPDATE book
        SET status = #{status}
        WHERE id = #{id}
    </update>
</mapper>
